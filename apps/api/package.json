{
  "name": "@simulatornet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal internal Fastify API for validation and deterministic verification.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/swagger": "^9.5.0",
    "@sim/authz": "workspace:*",
    "@sim/contracts": "workspace:*",
    "@sim/db": "workspace:*",
    "@sim/grading-core": "workspace:*",
    "@sim/lab-format": "workspace:*",
    "@simulatornet/verifier": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@sim/cli-engine": "workspace:*",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
