{
  "name": "@simulatornet/verifier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless Node adapter and fixture CLI for deterministic grading.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "verify": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {
    "@sim/contracts": "workspace:*",
    "@sim/grading-core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
