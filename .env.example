# PostgreSQL (development placeholders only)
DATABASE_URL=postgresql://simulatornet:change-me@127.0.0.1:5432/simulatornet
TEST_DATABASE_URL=postgresql://simulatornet:simulatornet_test_only@127.0.0.1:55432/simulatornet_test

# Local Compose placeholders. Copy this file to .env and replace every change-me.
SIMULATORNET_DB_NAME=simulatornet
SIMULATORNET_DB_USER=simulatornet
SIMULATORNET_DB_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me
KAI_PLATFORM_CLIENT_SECRET=change-me

KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8080
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/simulatornet
KEYCLOAK_JWKS_URL=http://127.0.0.1:8080/realms/simulatornet/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=simulatornet-api
WEB_ORIGIN=http://127.0.0.1:4173
PUBLIC_WEB_URL=http://127.0.0.1:4173
API_BASE_URL=http://127.0.0.1:3000
OPENAPI_ENABLED=true
