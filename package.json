{
  "name": "simulatornet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source browser-based network simulator (CCNA-level). Deterministic TypeScript simulation core shared by browser and server verifier.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "pnpm --filter @sim/web dev",
    "dev:api": "pnpm --filter @simulatornet/api dev",
    "build": "pnpm --filter @sim/web build",
    "build:server": "pnpm --filter @simulatornet/verifier build && pnpm --filter @simulatornet/api build",
    "db:generate": "pnpm --filter @sim/db db:generate",
    "db:migrate": "pnpm --filter @sim/db db:migrate",
    "db:check": "pnpm --filter @sim/db db:check",
    "db:seed:dev": "pnpm --filter @sim/db db:seed:dev",
    "db:test:integration": "pnpm --filter @sim/db test:integration",
    "infra:up": "docker compose up -d --build --wait",
    "infra:down": "docker compose down",
    "smoke:m8": "bash infra/smoke-m8.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packet-tracer:real": "PACKET_TRACER_REQUIRE_REAL=1 vitest run packages/packet-tracer-format/tests/real-container.test.ts",
    "test:e2e": "playwright test",
    "verify:fixture": "pnpm --filter @simulatornet/verifier verify --submission ./fixtures/submission.json --grading ./fixtures/grading.json",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
